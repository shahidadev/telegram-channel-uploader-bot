# ==========================================
# Telegram Channel Media Uploader Bot Config
# ==========================================

# 1. Telegram Bot Token from @BotFather
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# 2. Master Password for User Authentication (Change this to your preferred password)
MASTER_PASSWORD=mysecretpassword123

# 3. Owner Telegram User ID (Optional, get from @userinfobot to receive admin alerts)
OWNER_ID=0

# 4. Database Path (Default: bot_database.db)
DB_PATH=bot_database.db

# 5. Security Settings
AUTO_DELETE_PASSWORD=True
MAX_LOGIN_ATTEMPTS=5
LOGIN_COOLDOWN_SECONDS=60

# 6. Default Upload Settings
DEFAULT_PREVIEW_MODE=True
WORKER_COUNT=1
MAX_BOT_DOWNLOAD_MB=20

# 7. Promotion & Central Channel Routing (Optional)
# Set MAIN_CHANNEL_USERNAME to route all subscriber join buttons to a central channel
MAIN_CHANNEL_USERNAME=
# Set PROMO_BOT_USERNAME to display a promo button directing users to your main bot
PROMO_BOT_USERNAME=

# 8. Cloud Hosting / Health Check Web Server (Render, Koyeb, Railway)
ENABLE_WEB_SERVER=True
PORT=8080

